# Smelt role-based config template — copy to .env and fill in real values:
#   cp .env.example .env
# Each role has four keys: PROVIDER / BASE_URL / API_KEY / MODEL.
# SMELT_<ROLE>_* wins; the shared keys (SMELT_API_KEY etc.) are the common fallback.

# ---- Shared fallback (optional) ----
# SMELT_LLM_PROVIDER=openai
# SMELT_BASE_URL=https://api.moonshot.cn/v1
# SMELT_API_KEY=sk-...

# ---- Judge (writing review / llm_judge) ----
SMELT_JUDGE_PROVIDER=openai
SMELT_JUDGE_BASE_URL=https://api.moonshot.cn/v1
SMELT_JUDGE_API_KEY=
SMELT_JUDGE_MODEL=kimi-k2

# ---- Doctor (smelt doctor: mutation check + judge canary) ----
# Prefer a different model family than the agent under test to avoid shared blind spots.
SMELT_DOCTOR_PROVIDER=openai
SMELT_DOCTOR_BASE_URL=https://api.moonshot.cn/v1
SMELT_DOCTOR_API_KEY=
SMELT_DOCTOR_MODEL=kimi-k2

# ---- Challenger (evaluate adversarial probes) ----
SMELT_CHALLENGER_PROVIDER=openai
SMELT_CHALLENGER_BASE_URL=https://api.moonshot.cn/v1
SMELT_CHALLENGER_API_KEY=
SMELT_CHALLENGER_MODEL=kimi-k2

# ---- Agent under test (evaluate auto-binding, optional) ----
# SMELT_AGENT_PROVIDER=openai
# SMELT_AGENT_BASE_URL=https://api.moonshot.cn/v1
# SMELT_AGENT_API_KEY=
# SMELT_AGENT_MODEL=kimi-k2
